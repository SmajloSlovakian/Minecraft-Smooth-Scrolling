{
	"schemaVersion": 1,
	"id": "smoothscroll",
	"version": "${version}",
	"name": "Smooth Scrolling",
	"description": "Adds smooth scrolling to various elements",
	"authors": [
		"Smajslo"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/smooth-scroll",
		"sources": "https://github.com/SmajloSlovakian/Minecraft-Smooth-Scrolling"
	},
	"license": "gpl-3.0",
	"icon": "assets/smoothscroll/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.smajloslovakian.smoothscroll.SmoothScrolling"
		],
		"client": [
			"io.github.smajloslovakian.smoothscroll.SmoothSc"
		],
		"modmenu": [
			"io.github.smajloslovakian.smoothscroll.menu.ModMenuImpl"
		]
	},
	"mixins": [
		"smoothscroll.mixins.json",
		{
			"config": "smoothscroll.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": "${fabric_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": "${java_dependency}"
	},
	"custom": {
		"jade": {
			"smoothScroll": true
		}
	}
}
